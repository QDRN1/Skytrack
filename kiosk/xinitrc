#!/bin/sh
# =============================================================================
# SkyTrack .xinitrc — used by startx to launch Openbox + kiosk
# =============================================================================

# Start window manager (lightweight, no desktop)
openbox-session &

# Give WM a moment to initialize before launching Chromium
sleep 2

# Launch the kiosk script
exec /opt/skytrack/kiosk/skytrack-kiosk.sh
