# SkyTrack Portal environment file
# Installed at /etc/skytrack/skytrack.env by install.sh
# Sourced by every skytrack-*.service via EnvironmentFile=
#
# Override any of these to repoint the install. Lines starting with `#`
# are ignored. After editing, restart the affected unit:
#
#   sudo systemctl restart skytrack-app

# Filesystem layout
SKYTRACK_REPO_DIR=/opt/skytrack
SKYTRACK_DATA_DIR=/var/lib/skytrack
SKYTRACK_LOG_DIR=/var/log/skytrack
SKYTRACK_DB_PATH=/var/lib/skytrack/skytrack.db
SKYTRACK_USER=skytrack

# Web server
SKYTRACK_BIND=0.0.0.0
SKYTRACK_PORT=8080

# Hotspot defaults — change SSID via the Settings page once the device is up.
SKYTRACK_SSID=SkyTrack-Portal
SKYTRACK_COUNTRY=US
SKYTRACK_CHANNEL=6
SKYTRACK_GATEWAY=10.4.26.89
SKYTRACK_SUBNET=10.4.26.0/24
SKYTRACK_DHCP_START=10.4.26.100
SKYTRACK_DHCP_END=10.4.26.200

# DEV_MODE=1 forces mock sensors + mock aircraft and disables GPIO. Leave
# blank on real hardware.
#DEV_MODE=
