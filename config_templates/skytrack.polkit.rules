// /etc/polkit-1/rules.d/50-skytrack.rules
//
// Lets the unprivileged `skytrack` service user drive the handful of
// privileged operations the SkyTrack portal depends on:
//
//   1. Bounce specific systemd units (Restart App / Network / Hotspot,
//      OTA self-restart, hotspot apply/rollback, dump1090).
//   2. Reboot and power-off the device from Settings → Diagnostics.
//   3. Configure NetworkManager: edit cellular APN, scan/join Wi-Fi,
//      enable/disable the radio, manage the SkyTrack-Portal hotspot
//      connection profile.
//
// Without these grants:
//   * "Restart" and "Reboot" buttons silently fail with
//     "Interactive authentication required."
//   * APN saves return "Not authorized to control networking."
//   * The hotspot apply path can't activate its own connection profile.
//
// This is a single-purpose appliance — there is no interactive login
// session to consent on the device — so we grant the specific verbs
// statically, scoped to the service user only.
//
// Installed by install.sh into /etc/polkit-1/rules.d/50-skytrack.rules.
// Polkit picks up the new rule on the next action evaluation; no daemon
// reload is required.

// ---------------------------------------------------------------------------
// 1. systemd unit management — start/stop/restart of allow-listed units
// ---------------------------------------------------------------------------
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return;
    }
    if (subject.user !== "skytrack") {
        return;
    }
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb") || "";

    var allowedVerbs = {
        "start": true, "stop": true, "restart": true,
        "try-restart": true, "reload": true, "reload-or-restart": true,
    };
    if (!allowedVerbs[verb]) {
        return;
    }

    // Any unit whose name begins with "skytrack-" is fair game (we own
    // the namespace). Third-party units are listed explicitly.
    if (unit.indexOf("skytrack-") === 0) {
        return polkit.Result.YES;
    }
    var thirdParty = {
        "hostapd.service":         true,
        "dnsmasq.service":         true,
        "dhcpcd.service":          true,
        "NetworkManager.service":  true,
        "wpa_supplicant.service":  true,
        "systemd-timesyncd.service": true,
        "dump1090-fa.service":     true,
        "piaware.service":         true,
        "fr24feed.service":        true,
    };
    if (thirdParty[unit]) {
        return polkit.Result.YES;
    }
});

// ---------------------------------------------------------------------------
// 2. login1 — reboot and power-off without a login session
//
// systemd-logind exposes a separate polkit namespace from manage-units.
// Each verb has *-multiple-sessions and *-multiple-sessions-multiple-users
// variants that fire when more than one session is attached (e.g. the
// kiosk display + an SSH session). We grant the full set so reboot
// reliably works in every state.
// ---------------------------------------------------------------------------
polkit.addRule(function (action, subject) {
    if (subject.user !== "skytrack") {
        return;
    }
    var allowed = {
        "org.freedesktop.login1.reboot":                                 true,
        "org.freedesktop.login1.reboot-multiple-sessions":               true,
        "org.freedesktop.login1.reboot-ignore-inhibit":                  true,
        "org.freedesktop.login1.power-off":                              true,
        "org.freedesktop.login1.power-off-multiple-sessions":            true,
        "org.freedesktop.login1.power-off-ignore-inhibit":               true,
        "org.freedesktop.login1.halt":                                   true,
        "org.freedesktop.login1.halt-multiple-sessions":                 true,
        "org.freedesktop.login1.set-reboot-parameter":                   true,
    };
    if (allowed[action.id]) {
        return polkit.Result.YES;
    }
});

// ---------------------------------------------------------------------------
// 3. NetworkManager — APN edits, Wi-Fi scan/join, hotspot management
//
// nmcli routes every privileged operation through one of these polkit
// actions. Without an explicit grant the unprivileged service user gets
// "Not authorized to control networking" on first call.
// ---------------------------------------------------------------------------
polkit.addRule(function (action, subject) {
    if (subject.user !== "skytrack") {
        return;
    }
    var allowed = {
        "org.freedesktop.NetworkManager.settings.modify.system":  true,
        "org.freedesktop.NetworkManager.settings.modify.own":     true,
        "org.freedesktop.NetworkManager.settings.modify.hostname": true,
        "org.freedesktop.NetworkManager.network-control":         true,
        "org.freedesktop.NetworkManager.enable-disable-network":  true,
        "org.freedesktop.NetworkManager.enable-disable-wifi":     true,
        "org.freedesktop.NetworkManager.enable-disable-wwan":     true,
        "org.freedesktop.NetworkManager.wifi.scan":               true,
        "org.freedesktop.NetworkManager.wifi.share.protected":    true,
        "org.freedesktop.NetworkManager.wifi.share.open":         true,
        "org.freedesktop.NetworkManager.sleep-wake":              true,
    };
    if (allowed[action.id]) {
        return polkit.Result.YES;
    }
});
