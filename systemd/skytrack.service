[Unit]
Description=QDRNow-SkyTrack ADS-B Dashboard
After=network-online.target dump1090-fa.service
Wants=network-online.target

[Service]
Type=simple
User=SkyTrack
Group=SkyTrack
WorkingDirectory=/opt/skytrack
ExecStart=/opt/skytrack/venv/bin/python app.py
Restart=always
RestartSec=5
TimeoutStopSec=15

# Logging
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=skytrack

# Environment
Environment="SKYTRACK_CONFIG=/opt/skytrack/config.yaml"

# Hardening
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
