[Unit]
Description=SkyTrack Chromium Kiosk (X11 + Openbox)
After=skytrack.service network-online.target
Wants=skytrack.service network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=SkyTrack
Group=SkyTrack
PAMName=login
TTYPath=/dev/tty1

# X11 needs a virtual terminal
Environment="DISPLAY=:0"
StandardInput=tty
StandardOutput=journal
StandardError=journal

ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/startx /opt/skytrack/kiosk/xinitrc -- :0 vt1 -keeptty -noreset
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical.target
