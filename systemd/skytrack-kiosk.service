[Unit]
Description=SkyTrack Chromium Kiosk (X11 + Openbox)
After=skytrack.service network-online.target
Wants=skytrack.service network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=SkyTrack
Group=SkyTrack
PAMName=login
TTYPath=/dev/tty1

# X11 environment — explicit so xrandr/xset/chromium work reliably
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/SkyTrack/.Xauthority"
Environment="HOME=/home/SkyTrack"

StandardInput=tty
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skytrack-kiosk

ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/startx /opt/skytrack/kiosk/xinitrc -- :0 vt1 -keeptty -noreset

Restart=on-failure
RestartSec=10

# Prevent hangs on stop/restart
TimeoutStartSec=120
TimeoutStopSec=15
KillMode=mixed

# Chromium may exit 1 on SIGTERM — treat as clean
SuccessExitStatus=0 1

[Install]
WantedBy=graphical.target
