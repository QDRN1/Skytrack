[Unit]
Description=SkyTrack Portal v2 — network monitor (cellular + wifi + hotspot)
After=network.target NetworkManager.service ModemManager.service skytrack-firstboot.service
Wants=skytrack-firstboot.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/skytrack
EnvironmentFile=-/etc/skytrack/skytrack.env
# Runs the network supervisor: probes cell, switches between hotspot/upstream,
# refreshes mmcli stats, and emits events the app subscribes to.
ExecStart=/opt/skytrack/venv/bin/python -m network_svc --supervise
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=skytrack-network

# Needs root for nmcli/mmcli/ip-link toggles, but we still pin the rest.
NoNewPrivileges=false
ProtectSystem=false
ReadWritePaths=/var/lib/skytrack /var/log/skytrack

[Install]
WantedBy=multi-user.target
