[Unit]
Description=SkyTrack Portal v2 — web app
Documentation=https://github.com/qdrnow/skytrack
After=network.target skytrack-firstboot.service
Wants=skytrack-firstboot.service

[Service]
Type=simple
User=skytrack
Group=skytrack
WorkingDirectory=/opt/skytrack
EnvironmentFile=-/etc/skytrack/skytrack.env
ExecStart=/opt/skytrack/.venv/bin/python /opt/skytrack/app.py
Restart=always
RestartSec=5
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=skytrack-app

# Hardening — relaxed for appliance mode.  The app needs sudo for
# package installs, service restarts, reboots, and hotspot management.
# Security on this single-purpose device comes from physical access
# control and network isolation, not process sandboxing.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
