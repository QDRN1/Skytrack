[Unit]
Description=SkyTrack Portal v2 — ADS-B sightings ingest
After=network.target dump1090-fa.service skytrack-firstboot.service
Wants=skytrack-firstboot.service

[Service]
Type=simple
User=skytrack
Group=skytrack
WorkingDirectory=/opt/skytrack
EnvironmentFile=-/etc/skytrack/skytrack.env
# Runs the dump1090 → SQLite pipeline as a standalone process so the web
# app can crash and restart without losing tracker data.
ExecStart=/opt/skytrack/venv/bin/python -m ingest --standalone
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=skytrack-ingest

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/skytrack /var/log/skytrack

[Install]
WantedBy=multi-user.target
