[Unit]
Description=SkyTrack Portal v2 — DHT22 temp/humidity + buzzer driver
After=skytrack-firstboot.service
Wants=skytrack-firstboot.service

[Service]
Type=simple
# Needs GPIO access — runs as root but locked down otherwise.
User=root
Group=root
WorkingDirectory=/opt/skytrack
EnvironmentFile=-/etc/skytrack/skytrack.env
# Polls DHT22 on GPIO 21 every 15 s, drives the buzzer on GPIO 18 if the
# buzzer threshold is exceeded. Reads thresholds from config.yaml.
ExecStart=/opt/skytrack/.venv/bin/python -m buzzer --supervise
Restart=on-failure
RestartSec=10
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=skytrack-hardware

NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/skytrack /var/log/skytrack /sys/class/gpio /dev/gpiochip0 /dev/gpiomem

[Install]
WantedBy=multi-user.target
