[Unit]
Description=SkyTrack Portal v2 — wlan0 hotspot bring-up
After=skytrack-firstboot.service network.target
Before=skytrack-app.service
ConditionPathExists=/opt/skytrack/scripts/hotspot_apply.sh

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/opt/skytrack
EnvironmentFile=-/etc/skytrack/skytrack.env
ExecStart=/opt/skytrack/scripts/hotspot_apply.sh --reapply
ExecStop=/opt/skytrack/scripts/hotspot_rollback.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skytrack-hotspot

[Install]
WantedBy=multi-user.target
